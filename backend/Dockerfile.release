# Stage 1: Builder
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Copy go mod and sum files
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy the source code
COPY backend/. .

# Build the Go app for Linux AMD64. CGO_ENABLED=0 is important for scratch/micro images.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o main ./cmd/valiant

# Stage 2: Release
FROM registry.access.redhat.com/ubi9/ubi-micro

# Create the app directory and set permissions
# This ensures that any user belonging to the root group (GID 0) can read/write.
RUN mkdir -p /app && chown -R 1001:0 /app && chmod -R g+rwx /app

WORKDIR /app

# Copy the compiled binary and migrations from the builder stage.
COPY --from=builder /app/main .
COPY --from=builder /app/migrations ./migrations
RUN chmod +x /app/main

# Set the user to run as. In OpenShift, this will be overridden by a random UID,
# but the user will be in group 0, so it will have the necessary permissions.
USER 1001

EXPOSE 8080
CMD ["./main"]
